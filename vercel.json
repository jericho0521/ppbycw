{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ppbycw.com"
        }
      ],
      "destination": "https://ppbycw.com/$1",
      "permanent": true
    },
    {
      "source": "/Events",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/FAQ",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/About",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/#pricing",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/#community",
      "permanent": true
    }
  ]
}
